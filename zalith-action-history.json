  {
    "id": 34047925073,
    "sha": "9a3f8f0ea3e774bc4ac274f51233058a5472c0d0",
    "short_sha": "9a3f8f0",
    "message": "Merge pull request #1794 from ZalithLauncher/fix/fgs_start_timeout\n\nfix: 保活前台服务启动超时导致游戏进程崩溃",
    "created_at": "2026-09-06T17:13:24Z",
