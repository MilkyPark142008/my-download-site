  {
    "id": 33100766833,
    "sha": "9eb62f2449c026f862f3e88f6a2c7b4bff64ea7a",
    "short_sha": "9eb62f2",
    "message": "Merge pull request #1727 from ZalithLauncher/refactor/download\n\nrefactor: 重构下载体系为统一的多线程下载引擎，收敛镜像源设置",
    "created_at": "2026-08-27T17:54:01Z",
