  {
    "id": 33089429488,
    "sha": "9c0e85bd2c7a1e1b61ff5b079de0e38637f178da",
    "short_sha": "9c0e85b",
    "message": "Merge pull request #1725 from ZalithLauncher/weblate_main\n\nWeblate main",
